# Python virtual environments
.venv/
venv/
env/
ENV/

# Claude Code settings (exclude user-local settings but keep repo-level commands AND skills)
# Rick's ruling 2026-07-16: repo-level Skills and Commands are BOTH tracked.
# Before this, `.claude/*` ignored everything and only `commands/` was negated back in — so all four
# skills (push-to-completion, plan-post-game, spin-up-swe-team, guided-decision-walkthrough) were
# untracked: absent from a fresh clone, erased by `git clean -fd`, and propagating to nobody.
# The commands were tracked and the SKILLS THAT ACTIVATE THEM WERE NOT — the rule was versioned and
# the mechanism was not.
.claude/*
!.claude/commands/
!.claude/skills/

# IDE directories
.idea/
.vscode/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
# `.coverage` alone does NOT match the PER-PROCESS files that `parallel = True` writes
# (`.coverage.<host>.<pid>.<rand>`) — and a subprocess-driven suite makes dozens of them per
# run. 63 landed untracked on 2026-07-21, one `git add -A` away from being committed.
.coverage.*
coverage.xml
htmlcov/
.tox/

# OS files
.DS_Store
Thumbs.db

# Claude session manifest (parallel session tracking)
.claude-session.md

# Claude session memento (pre-context-clear state snapshot for rehydration)
.claude-memento.md
io/mementos/

# Claude heartbeat hold (runtime liveness-state file, rewritten every turn)
.heartbeat-hold-*.json

# Git LoC-delta artifacts (per-branch CSV + meta, regenerated every session-end)
io/git-loc-delta/
io/post-games/

# Claude mementos (records + pointers) — NEVER commit: a memento that
# will be committed is written more carefully, and therefore less honestly.
.claude-memento-*.md
